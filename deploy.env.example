# Copy to deploy.env (git-ignored) and fill in. See DEPLOY.md.
PROJECT=my-money-123456            # your Google Cloud project ID
REGION=europe-west1                # Belgium: close to Spain, every service, cheapest Cloud Run prices
SHEET_ID=                          # from the sheet's link: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
ALLOWED_EMAILS=you@gmail.com       # who may sign in (comma-separated for more than one)
GOOGLE_CLIENT_ID=                  # the OAuth client ID (DEPLOY.md, step 4)
